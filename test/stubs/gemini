#!/bin/bash
# Stand-in for the gemini CLI. Like the real one, `mcp add -s user` writes ~/.gemini/settings.json.
echo "gemini $*" >> "$STUB_STATE/calls.log"
[ "${1:-}" = mcp ] || exit 0
case "$2" in
  list) echo "Configured MCP servers:"; echo; for f in "$STUB_STATE"/gemini/*; do [ -e "$f" ] && echo "✓ $(basename "$f"): $(cat "$f")"; done; exit 0 ;;
  add) shift 2; while [ $# -gt 0 ]; do case "$1" in -s|-t) shift 2 ;; -*) shift ;; *) break ;; esac; done
       mkdir -p "$STUB_STATE/gemini" "$HOME/.gemini"; echo "$*" > "$STUB_STATE/gemini/$1"
       python3 -I - "$HOME/.gemini/settings.json" "$1" <<'PY'
import json, sys
path, name = sys.argv[1:3]
try: d = json.load(open(path))
except Exception: d = {}
d.setdefault("mcpServers", {})[name] = {"stub": True}
json.dump(d, open(path, "w"), indent=2)
PY
     ;;
esac
