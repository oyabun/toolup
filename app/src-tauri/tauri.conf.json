{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tool up!",
  "version": "0.0.1",
  "identifier": "sh.toolup.app",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tool up!",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 31
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
